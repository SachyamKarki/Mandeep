# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git, so passwords never end up in the repository.

# ---- MySQL connection used by the app ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mangaldeep_claims

# App account (MySQL role mcs_admin; see database/06_access.sql)
DB_USER=mcs_app
DB_PASSWORD=change_me

# ---- Used only by `npm run db:setup` ----
# Schema owner: creates the tables, views and triggers. Falls back to DB_USER.
DB_SETUP_USER=mcs_owner
DB_SETUP_PASSWORD=change_me
